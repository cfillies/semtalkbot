{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
    "manifestVersion": "1.29",
    "version": "1.0.8",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Semtation GmbH",
        "websiteUrl": "https://www.semtalk.com",
        "privacyUrl": "https://www.semtalk.com/privacy",
        "termsOfUseUrl": "https://www.semtalk.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "SemTalk Process Bot v3",
        "full": "SemTalk Process Finder Bot v3"
    },
    "description": {
        "short": "Make your business processes accessible via chat",
        "full": "The SemTalk Process Bot helps you find and understand business processes stored in your SemTalk Process Repository directly from Microsoft Teams."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "copilotAgents": {
        "customEngineAgents": [
            {
                "type": "bot",
                "id": "${{BOT_ID}}"
            }
        ]
    },
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "copilot",
                "personal",
                "team"
            ],
            "supportsFiles": true,
            "isNotificationOnly": false,
            "supportsTargetedMessages": false,
            "commandLists": [
                {
                    "scopes": [
                        "copilot",
                        "personal"
                    ],
                    "triggers": ["mention"],
                    "commands": [
                        {
                            "title": "Find business processes",
                            "description": "Return a list of Process descriptions for a matching a Process name"
                        },
                        {
                            "title": "Explain a business process",
                            "description": "Return a BPMN Style Process description for a matching a Process name"
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [
        {
            "botId": "${{BOT_ID}}",
            "commands": [
                {
                    "id": "findProcess",
                    "type": "query",
                    "title": "Find process",
                    "description": "Search process ideas and insert a card",
                    "initialRun": true,
                    "parameters": [
                        {
                            "name": "query",
                            "title": "Search text",
                            "description": "Enter a process name or topic",
                            "inputType": "text"
                        }
                    ]
                },
                {
                    "id": "botConfig",
                    "type": "action",
                    "title": "Insert bot config command",
                    "description": "Create a card with bot runtime config instructions",
                    "parameters": [
                        {
                            "name": "mode",
                            "title": "Mode",
                            "description": "default, json, or debug",
                            "inputType": "text"
                        },
                        {
                            "name": "definitionFile",
                            "title": "BPMN Workflow (SemTalk Library)",
                            "description": "Example: langgraph.json",
                            "inputType": "text"
                        }
                    ]
                }
            ]
        }
    ],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}