<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:ai="http://example.com/ai">
  <process id="demoProcess">
    <startEvent id="start1" />
    <laneSet id="laneSet1">
      <lane id="lane1" name="Orchestrator">
        <flowNodeRef>task1</flowNodeRef>
        <ai:Agent systemPrompt="You are the orchestrator lane agent for intake and routing." />
      </lane>
      <lane id="lane2" name="Billing">
        <flowNodeRef>task2</flowNodeRef>
        <ai:Agent systemPrompt="You are the billing lane agent." />
      </lane>
      <lane id="lane3" name="Support">
        <flowNodeRef>task3</flowNodeRef>
        <ai:Agent systemPrompt="You are the support lane agent." />
      </lane>
    </laneSet>
    <task id="task1" name="Collect User Input">
      <ai:LLMTask promptTemplate="Collect the user's request in plain text."/>
    </task>
    <exclusiveGateway id="gateway1" />
    <task id="task2" name="Handle Billing">
      <ai:LLMTask promptTemplate="Generate billing instructions for the user."/>
    </task>
    <task id="task3" name="Handle Support">
      <ai:LLMTask promptTemplate="Provide support instructions for the user."/>
    </task>
    <endEvent id="end1" />
    <sequenceFlow id="flow1" sourceRef="start1" targetRef="task1"/>
    <sequenceFlow id="flow2" sourceRef="task1" targetRef="gateway1"/>
    <sequenceFlow id="flow3" sourceRef="gateway1" targetRef="task2" name="billing"/>
    <sequenceFlow id="flow4" sourceRef="gateway1" targetRef="task3" name="support"/>
    <sequenceFlow id="flow5" sourceRef="task2" targetRef="end1"/>
    <sequenceFlow id="flow6" sourceRef="task3" targetRef="end1"/>
  </process>
</definitions>
