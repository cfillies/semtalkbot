# .env.dev.template
# Copy this file to .env.dev and fill in actual secrets
# NEVER commit .env.dev to git - it's in .gitignore

# OpenAI API Key (required for agent)
# Get from: https://platform.openai.com/api-keys
SECRET_OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot Microsoft Entra password (generated during aadApp/create)
# Get from: env/.env.dev after provision, or Azure Entra app registration
SECRET_BOT_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MCP Server URL (your backend service)
# Example: https://semaiservice26.azurewebsites.net/runtime/webhooks/mcp?code=xxxxx
MCP_URL=https://your-mcp-server/runtime/webhooks/mcp?code=xxxxx

# Optional: MongoDB connection for persistence
# CONNECTION_STRING=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
